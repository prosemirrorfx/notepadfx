<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.prosefx</groupId>
    <artifactId>prosefx-notepadfx</artifactId>
    <version>0.1.16</version>
    <packaging>jar</packaging>
    <name>notepadfx</name>
    <description>A fast markdown and text editor: workspaces, vertical tabs, navigation panes, outline.</description>
    <url>https://github.com/prosefx/notepadfx</url>
    <issueManagement><url>https://github.com/prosefx/notepadfx/issues</url></issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>26.0.2</javafx.version>
        <datahelper.version>2.0</datahelper.version>
        <main.class>prosefx.notepadfx.Main</main.class>
        <jrexe.skip>false</jrexe.skip>
        <native.opt>2</native.opt>
        <reachability.version>1.0.0-RC5</reachability.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.prosefx</groupId>
            <artifactId>prosefx-view</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.prosefx</groupId>
            <artifactId>prosefx-writer</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.jarrunner</groupId>
            <artifactId>jr-apputils</artifactId>
            <version>1.1</version>
        </dependency>
        <dependency>
            <groupId>io.github.luvml</groupId>
            <artifactId>luvjfx</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.datapotter</groupId>
            <artifactId>datapotter-datahelper-base</artifactId>
            <version>${datahelper.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.datapotter</groupId>
            <artifactId>datapotter-datahelper-annotations</artifactId>
            <version>${datahelper.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.datapotter</groupId>
            <artifactId>datapotter-datahelper-json</artifactId>
            <version>${datahelper.version}</version>
        </dependency>
        <dependency>
            <groupId>us.hebi.graalvm</groupId>
            <artifactId>reachability-annotations</artifactId>
            <version>${reachability.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>notepadfx</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.datapotter</groupId>
                            <artifactId>datapotter-datahelper-processor</artifactId>
                            <version>${datahelper.version}</version>
                        </path>
                        <path>
                            <groupId>us.hebi.graalvm</groupId>
                            <artifactId>reachability-processor</artifactId>
                            <version>${reachability.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                        <arg>-Areachability.outputFormat=1.2.0</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.jarrunner</groupId>
                <artifactId>jr-maven-plugin</artifactId>
                <version>1.6.0</version>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals><goal>exe</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${jrexe.skip}</skip>
                    <name>notepadfx</name>
                    <icon>${project.basedir}/pkg/notepadfx.ico</icon>
                    <jarUrl>https://github.com/prosefx/notepadfx/releases/download/v${project.version}/notepadfx-{sha8}.jar</jarUrl>
                    <updateUrl>https://github.com/prosefx/notepadfx/releases/latest/download/notepadfx.update.json</updateUrl>
                    <supportName>notepadfx</supportName>
                    <productName>notepadfx</productName>
                    <companyName>prosefx</companyName>
                    <copyright>prosefx contributors</copyright>
                    <javaVersion>25+</javaVersion>
                    <jvmMode>dll</jvmMode>
                    <aot>true</aot>
                    <!-- PRP-61: what notepadfx needs from macOS, said up front; each sentence is what the person reads when macOS asks -->
                    <macosPermissions>
                        <microphone>notepadfx listens to your microphone only when you press F3 to dictate.</microphone>
                        <documents>notepadfx opens and saves the notes and documents you choose in Documents.</documents>
                        <desktop>notepadfx opens and saves the notes and documents you choose on the Desktop.</desktop>
                        <downloads>notepadfx opens and saves the files you choose in Downloads.</downloads>
                        <removableVolumes>notepadfx opens and saves files on drives you choose.</removableVolumes>
                        <networkVolumes>notepadfx opens and saves files on network drives you choose.</networkVolumes>
                    </macosPermissions>
                    <vmArgs>
                        <vmArg>-Xms16m</vmArg>
                        <vmArg>-Xmx512m</vmArg>
                        <vmArg>-Xss512k</vmArg>
                        <vmArg>-XX:+UseSerialGC</vmArg>
                        <vmArg>-XX:MinHeapFreeRatio=10</vmArg>
                        <vmArg>-XX:MaxHeapFreeRatio=30</vmArg>
                        <vmArg>-XX:TieredStopAtLevel=1</vmArg>
                        <vmArg>-XX:MaxMetaspaceSize=128m</vmArg>
                        <vmArg>-XX:ReservedCodeCacheSize=48m</vmArg>
                        <vmArg>-XX:MaxDirectMemorySize=64m</vmArg>
                        <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                    </vmArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Experimental: a GraalVM native image with JavaFX linked in statically (StaticFX).
         Needs Oracle GraalVM 25 as JAVA_HOME and MSVC on PATH: see pkg/native-build.cmd. -->
    <profiles>
        <profile>
            <id>native</id>
            <properties>
                <jrexe.skip>true</jrexe.skip>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>us.hebi.graalvm</groupId>
                    <artifactId>jfx-static-feature</artifactId>
                    <version>1.1.1</version>
                </dependency>
                <dependency>
                    <groupId>us.hebi.graalvm</groupId>
                    <artifactId>jfx-static-libs</artifactId>
                    <version>${javafx.version}-1</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.17</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <phase>package</phase>
                                <goals><goal>compile-no-fork</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>notepadfx</imageName>
                            <mainClass>${main.class}</mainClass>
                            <fallback>false</fallback>
                            <metadataRepository><enabled>false</enabled></metadataRepository>
                            <buildArgs>
                                <buildArg>-O${native.opt}</buildArg>
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <buildArg>-H:+ForeignAPISupport</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
